APP_ENV=development
BACKEND_ORIGIN=http://localhost:4010
WEB_ORIGIN=http://localhost:3000
WEB_LOGIN_ENABLED=false
LOCAL_STACK_ID=reading-foundation
# Keep login disabled until all paired identity/origin settings are configured.
# A local identity stack supplies its own isolated demo project and emulator port.
# WEB_CSRF_SECRET=<generate at least 32 random bytes; keep only in ignored local config or a secret manager>
# IDENTITY_WEB_API_KEY=<public Firebase web API key>
# IDENTITY_AUTH_DOMAIN=<authorized auth hostname, without a scheme or path>
# IDENTITY_PROJECT_ID=<paired Firebase/Identity Platform project ID>
# IDENTITY_WEB_APP_ID=<Firebase web app ID, such as 1:123456789:web:0123456789abcdef>
# IDENTITY_AUTH_EMULATOR_ORIGIN=http://127.0.0.1:9099
# The emulator setting is Development only and requires a demo-* project.
# Never put a real secret in this example or commit a local .env file.
