{
  "name": "blogpost-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts",
    "test:e2e": "playwright test",
    "contract:generate": "node scripts/contract-types.mjs",
    "contract:check": "node scripts/contract-types.mjs --check",
    "verify": "node scripts/verify-foundation.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED"
}
